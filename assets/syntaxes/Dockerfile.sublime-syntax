%YAML 1.2
---
# Authored for ocode (MIT). Instructions, comments, strings and variables.
name: Dockerfile
file_extensions:
  - Dockerfile
  - dockerfile
scope: source.dockerfile
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign.dockerfile
    - match: '(?i)^\s*(FROM|RUN|CMD|LABEL|MAINTAINER|EXPOSE|ENV|ADD|COPY|ENTRYPOINT|VOLUME|USER|WORKDIR|ARG|ONBUILD|STOPSIGNAL|HEALTHCHECK|SHELL)\b'
      scope: keyword.control.dockerfile
    - match: '(?i)\b(AS)\b'
      scope: keyword.operator.dockerfile
    - match: '"'
      scope: punctuation.definition.string.begin.dockerfile
      push: double_quoted
    - match: "'"
      scope: punctuation.definition.string.begin.dockerfile
      push: single_quoted
    - match: '\$\{?[A-Za-z_][A-Za-z0-9_]*\}?'
      scope: variable.other.dockerfile
    # Three scopes carry most of the signal in a glance: what is called,
    # what is a fixed value, and what is a type. Ordered so a call wins
    # over the shape of its name.
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: entity.name.function.dockerfile
    - match: '\b[A-Z][A-Z0-9_]{2,}\b'
      scope: constant.other.dockerfile
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.class.dockerfile entity.name.type.dockerfile support.class.dockerfile
  double_quoted:
    - match: '"'
      scope: punctuation.definition.string.end.dockerfile
      pop: true
    - match: '\\.'
      scope: constant.character.escape.dockerfile
    - match: '.'
      scope: string.quoted.double.dockerfile
  single_quoted:
    - match: "'"
      scope: punctuation.definition.string.end.dockerfile
      pop: true
    - match: '.'
      scope: string.quoted.single.dockerfile
