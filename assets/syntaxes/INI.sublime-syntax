%YAML 1.2
---
# Authored for ocode (MIT). Sections, comments and key = value pairs.
name: INI
file_extensions:
  - ini
  - cfg
  - conf
scope: source.ini
contexts:
  main:
    - match: '^\s*[;#].*$'
      scope: comment.line.ini
    - match: '^\s*(\[)([^\]]*)(\])'
      captures:
        1: punctuation.definition.section.begin.ini
        2: entity.name.section.ini
        3: punctuation.definition.section.end.ini
    - match: '^\s*([^=;#\[\s][^=]*?)\s*(=)'
      captures:
        1: keyword.other.definition.ini
        2: punctuation.separator.key-value.ini
      push: value
    # Three scopes carry most of the signal in a glance: what is called,
    # what is a fixed value, and what is a type. Ordered so a call wins
    # over the shape of its name.
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: entity.name.function.ini
    - match: '\b[A-Z][A-Z0-9_]{2,}\b'
      scope: constant.other.ini
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.class.ini entity.name.type.ini support.class.ini
  value:
    - match: '$'
      pop: true
    - match: '[;#].*$'
      scope: comment.line.ini
    - match: '"'
      push: double_quoted
    - match: '\b\d+(\.\d+)?\b'
      scope: constant.numeric.ini
    - match: '\b(true|false|yes|no|on|off)\b'
      scope: constant.language.ini
    - match: '.'
      scope: string.unquoted.ini
  double_quoted:
    - match: '"'
      pop: true
    - match: '\\.'
      scope: constant.character.escape.ini
    - match: '.'
      scope: string.quoted.double.ini
