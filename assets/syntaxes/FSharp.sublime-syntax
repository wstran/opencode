%YAML 1.2
---
# Authored for ocode (MIT). Minimal F# highlighting.
# Block comments are (* ... *) — not /* */.
name: F#
file_extensions:
  - fs
  - fsx
  - fsi
scope: source.fsharp
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.fsharp
    - match: '\(\*'
      scope: punctuation.definition.comment.fsharp
      push: block_comment
    - match: '"""'
      scope: punctuation.definition.string.begin.fsharp
      push: block_string
    - match: '@"'
      scope: punctuation.definition.string.begin.fsharp
      push: verbatim_string
    - match: '"'
      scope: punctuation.definition.string.begin.fsharp
      push: double_string
    - match: "'.'"
      scope: string.quoted.single.fsharp
    - match: '\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|\d[\d_]*(\.[\d_]+)?([eE][+-]?\d+)?[uUlLfFmMyYsSnL]?)\b'
      scope: constant.numeric.fsharp
    - match: '\b(true|false|null)\b'
      scope: constant.language.fsharp
    - match: '\b(let|mutable|rec|and|use|in|if|then|else|elif|match|with|when|fun|function|do|done|return|yield|namespace|module|open|type|abstract|member|interface|inherit|override|default|new|static|private|public|internal|of|as|upcast|downcast|lazy|assert|global|try|finally|raise|begin|end|while|for|to|downto|failwith|select|where|group|join|on|into|orderby|or|by)\b'
      scope: keyword.control.fsharp
    - match: '\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|float32|double|decimal|bool|string|char|byte|sbyte|unit|obj|Option|Result|List|Map|Set|Array|seq|Seq|IEnumerable)\b'
      scope: storage.type.fsharp
    # Three scopes carry most of the signal in a glance: what is called,
    # what is a fixed value, and what is a type. Ordered so a call wins
    # over the shape of its name.
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: entity.name.function.fsharp
    - match: '\b[A-Z][A-Z0-9_]{2,}\b'
      scope: constant.other.fsharp
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.class.fsharp entity.name.type.fsharp support.class.fsharp
  block_comment:
    - match: '\*\)'
      scope: punctuation.definition.comment.fsharp
      pop: true
    - match: '.'
      scope: comment.block.fsharp
  block_string:
    - match: '"""'
      scope: punctuation.definition.string.end.fsharp
      pop: true
    - match: '.'
      scope: string.quoted.block.fsharp
  verbatim_string:
    - match: '"'
      scope: punctuation.definition.string.end.fsharp
      pop: true
    - match: '.'
      scope: string.quoted.verbatim.fsharp
  double_string:
    - match: '"'
      scope: punctuation.definition.string.end.fsharp
      pop: true
    - match: '\\.'
      scope: constant.character.escape.fsharp
    - match: '.'
      scope: string.quoted.double.fsharp
