%YAML 1.2
---
# Authored for ocode (MIT). Minimal Move (Aptos/Sui) highlighting.
name: Move
file_extensions:
  - move
scope: source.move
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.move
    - match: '/\*'
      scope: punctuation.definition.comment.move
      push: block_comment
    - match: '[bx]?"'
      scope: punctuation.definition.string.begin.move
      push: double_string
    - match: '@(0x[0-9a-fA-F]+|[A-Za-z_][A-Za-z0-9_]*)'
      scope: constant.other.address.move
    - match: '\b(0x[0-9a-fA-F_]+|\d[\d_]*)(u8|u16|u32|u64|u128|u256)?\b'
      scope: constant.numeric.move
    - match: '\b(true|false)\b'
      scope: constant.language.move
    - match: '\b(module|script|fun|public|entry|native|friend|use|as|struct|has|let|mut|move|copy|return|if|else|while|loop|break|continue|abort|acquires|spec|const|invariant|assume|assert|ensures|requires|aborts_if|phantom|enum|match)\b'
      scope: keyword.control.move
    - match: '\b(key|store|drop|copy)\b'
      scope: storage.modifier.move
    - match: '\b(u8|u16|u32|u64|u128|u256|bool|address|signer|vector)\b'
      scope: storage.type.move
    # Three scopes carry most of the signal in a glance: what is called,
    # what is a fixed value, and what is a type. Ordered so a call wins
    # over the shape of its name.
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: entity.name.function.move
    - match: '\b[A-Z][A-Z0-9_]{2,}\b'
      scope: constant.other.move
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.class.move entity.name.type.move support.class.move
  block_comment:
    - match: '\*/'
      scope: punctuation.definition.comment.move
      pop: true
    - match: '.'
      scope: comment.block.move
  double_string:
    - match: '"'
      scope: punctuation.definition.string.end.move
      pop: true
    - match: '\\.'
      scope: constant.character.escape.move
    - match: '.'
      scope: string.quoted.double.move
